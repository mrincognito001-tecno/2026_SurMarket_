<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/TXVLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/Logintitle"
            android:textColor="#151A22"
            android:textSize="@dimen/titleTextSize"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TXVUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nombre de usuario"
            android:textColor="#20242A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/EDTUsername"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_input_background"
            android:hint="Ingresa tu nombre de usuario"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#20242A"
            android:textColorHint="#6687A8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/TXVPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Contraseña"
            android:textColor="#20242A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/EDTPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_input_background"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#20242A"
            android:textColorHint="#6687A8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/TXVRecoverPassword"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="Recuperar contraseña"
            android:textColor="#6687A8"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/BTNLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/login_primary_button"
            android:backgroundTint="@null"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTNRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_secondary_button"
            android:backgroundTint="@null"
            android:text="Regístrate aquí"
            android:textAllCaps="false"
            android:textColor="#151A22"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>